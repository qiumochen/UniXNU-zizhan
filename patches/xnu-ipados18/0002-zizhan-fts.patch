+/* ST FingerTip FST2 (chip 0x3652) inner touch of the Xiaomi MIX Fold 2 (zizhan, SM8475).
+ * The board plumbing -- QUP0 SE4 GENI SPI on GPIO16-19, IRQ GPIO21, reset GPIO20, RPMh supplies, GCC votes --
+ * is Pong's pong_goodix.c (itself from HackiOS redwood_goodix.c, APSL 2.0), because zizhan wires its inner touch
+ * to the same serial engine and pins. The chip layer follows the zizhan fst2 6.0.3 Linux driver. */
+#include <pexpert/arm64/board_config.h>
+#if defined(PONG)
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <pexpert/pexpert.h>
+#include <sys/pong_input.h>
+#include <kern/sched_prim.h>
+#include <pexpert/device_tree.h>
+#include <sys/systm.h>
+#include <sys/proc_internal.h>
+
