+/* zizhan 0012 (docs/plan/2026-10-31-triple-buffer-swapwait.md): after every SwapEnd N CoreAnimation asks whether N is on the panel
+ * (flags 0x80000001: a nonblocking query) and, before SwapEnd N+1, whether N has been replaced (0x80000000). Until now both always
+ * said yes, so with two canvases it draws into the other one while the panel may still be fetching it. fb_swapwait=1 answers for
+ * real: a query gets kIOReturnNotReady (2: kIOReturnBusy) while not yet, a blocking call sleeps up to 50 ms. */
+void
+IOMobileFramebuffer::swapPresentedLocked(uint32_t id)
+{
+	if (id != 0 && (int32_t) (id - fPresentedID) > 0) {
+		fRetiredID = fPresentedID;
+		fPresentedID = id;
+		IOLockWakeup(fSwapLock, &fPresentedID, false);
+	}
+}
+
+void
+IOMobileFramebuffer::swapPresented(uint32_t id)
+{
+	IOLockLock(fSwapLock);
+	swapPresentedLocked(id);
+	IOLockUnlock(fSwapLock);
+}
+
+IOReturn
+IOMobileFramebuffer::swapWait(uint32_t id, uint32_t flags)
+{
+	const bool query = (flags & 0x80000000u) != 0, presentedIsEnough = (flags & 1) != 0;
+	IOReturn ret = kIOReturnSuccess;
+	uint64_t deadline;
+
+	if (gSwapWait == 0 || id == 0) {
+		return kIOReturnSuccess;
+	}
+	clock_interval_to_deadline(50, kMillisecondScale, &deadline);
+	IOLockLock(fSwapLock);
+	for (;;) {
+		const uint32_t mark = presentedIsEnough ? fPresentedID : fRetiredID;
+
+		if ((int32_t) (id - fEndedID) > 0 || (int32_t) (mark - id) >= 0) {
+			break;                          /* never handed in, or already where CoreAnimation wants it */
+		}
+		if (query) {
+			ret = gSwapWait == 2 ? kIOReturnBusy : kIOReturnNotReady;
+			fStatSwapWaitNotReady++;
+			break;
+		}
+		if (IOLockSleepDeadline(fSwapLock, &fPresentedID, deadline, THREAD_ABORTSAFE) != THREAD_AWAKENED) {
+			fStatSwapWaitTimeouts++;
+			ret = kIOReturnTimeout;
+			break;
+		}
+	}
+	IOLockUnlock(fSwapLock);
+	return ret;
+}
