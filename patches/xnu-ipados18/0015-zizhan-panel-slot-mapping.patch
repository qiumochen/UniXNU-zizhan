+static void pong_panel_map_error(const char *phase, IOReturn error, uint64_t physical, uint64_t bytes, IOOptionBits options, bool kernel)
+{
+    static unsigned failures;
+    if (!pong_panel_slot_range(physical, bytes) || __atomic_fetch_add(&failures, 1u, __ATOMIC_RELAXED) >= 16) return;
+    char line[220];
+    int n = snprintf(line, sizeof line, "PONG POOL %s: error=0x%x phys=0x%llx bytes=%llu kernel=%u options=0x%x\n",
+        phase, error, physical, bytes, kernel, (unsigned)options);
+    if (n > 0) { IOLog("%s", line); pong_ramoops_diagnostic_write(line, n < (int)sizeof line ? n : (int)sizeof line - 1); }
+}
+#endif
