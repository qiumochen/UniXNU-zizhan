+// Called from the native request path. Counts are captured under the same
+// lock as producer/presenter. This is not an ack of panel power or visibility.
+void
+IOMobileFramebuffer::observePowerOwner(void)
+{
+	IOLockLock(fSwapLock);
+	if (fDisplayOwnerEnabled) {
+		const auto state = fDisplayOwner.snapshot();
+		IOLog("ZIZHAN_DISPLAY_OWNER: power-request state=%u queued=%u in-flight=%u software-completed=%llu hardware=UNQUALIFIED\n",
+		      static_cast<unsigned>(state.state), state.queued, state.in_flight, state.software_completed);
+	}
+	IOLockUnlock(fSwapLock);
 }
 
