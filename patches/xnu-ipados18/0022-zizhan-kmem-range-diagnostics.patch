zizhan: failure-only selected kernel allocation range observation; preserve policy/error.
--- a/osfmk/vm/vm_map.c
+++ b/osfmk/vm/vm_map.c
@@ -22791,6 +22791,41 @@
 	return KERN_SUCCESS;
 }
 
+/* zizhan APP-01: observe the actual selected allocation range, not the
+ * unrelated whole-map free total. Read-only and used only after failure. */
+void zizhan_vm_map_range_sizes(vm_map_t, vm_map_offset_t, vm_map_offset_t,
+    vm_map_size_t *, vm_map_size_t *, unsigned *);
+void
+zizhan_vm_map_range_sizes(vm_map_t map, vm_map_offset_t minimum,
+    vm_map_offset_t maximum, vm_map_size_t *total,
+    vm_map_size_t *largest, unsigned *entries)
+{
+    vm_map_entry_t entry;
+    vm_map_offset_t cursor = minimum;
+    *total = *largest = 0;
+    *entries = 0;
+    if (!map || maximum <= minimum) return;
+    vm_map_lock_read(map);
+    for (entry = vm_map_first_entry(map); entry != vm_map_to_entry(map);
+        entry = entry->vme_next) {
+        if (entry->vme_end <= minimum) continue;
+        if (entry->vme_start >= maximum) break;
+        if (entry->vme_start > cursor) {
+            vm_map_size_t gap = entry->vme_start - cursor;
+            *total += gap;
+            if (gap > *largest) *largest = gap;
+        }
+        if (entry->vme_end > cursor) cursor = entry->vme_end;
+        (*entries)++;
+    }
+    if (cursor < maximum) {
+        vm_map_size_t gap = maximum - cursor;
+        *total += gap;
+        if (gap > *largest) *largest = gap;
+    }
+    vm_map_unlock_read(map);
+}
+
 void
 vm_map_sizes(vm_map_t map,
     vm_map_size_t * psize,
