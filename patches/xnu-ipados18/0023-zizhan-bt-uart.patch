--- a/bsd/dev/zizhan_bt_uart.c	1970-01-01 08:00:00
+++ b/bsd/dev/zizhan_bt_uart.c	2026-11-20 01:14:09
@@ -0,0 +1,393 @@
+/*
+ * zizhan Bluetooth H4 UART: the BSD tty half of /dev/cu.bluetooth (and the alias /dev/uart.bluetooth) for bluetoothd.
+ *
+ * bluetoothd opens /dev/cu.bluetooth, calls tcgetattr/cfmakeraw/cfsetspeed/tcsetattr and waits with select/kevent, so
+ * this is a real struct tty (line discipline, termios, select and kqueue through ttselect). The UART itself (QCA6490 on
+ * the SE20 GENI UART, firmware already downloaded by the kernel) lives in ArmDTPlatform: it calls
+ * zizhan_bt_uart_attach() once with its transmit hook, then zizhan_bt_uart_input() for every received chunk.
+ * The hook takes at most what its ring can hold; tx(NULL, 0) returns the free space. When the ring drains after being
+ * full, the UART side calls zizhan_bt_uart_input(NULL, 0) to restart output.
+ * Nothing exists until attach is called, so the node is absent unless the UART side is enabled (default off).
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/conf.h>
+#include <sys/tty.h>
+#include <sys/proc.h>
+#include <sys/uio.h>
+#include <sys/fcntl.h>
+#include <sys/kernel.h>
+#include <miscfs/devfs/devfs.h>
+#include <kern/locks.h>
+#include <sys/kern_control.h>
+#include <sys/kpi_mbuf.h>
+#include <sys/termios.h>
+
+typedef int (*zizhan_bt_tx_t)(const uint8_t *buf, uint32_t len);
+int zizhan_bt_uart_attach(zizhan_bt_tx_t tx);
+void zizhan_bt_uart_input(const uint8_t *buf, uint32_t len);
+
+static struct tty *bt_tty;
+static zizhan_bt_tx_t bt_tx;
+static int bt_major = -1;
+static uint32_t bt_rx_dropped, bt_tx_bytes, bt_rx_bytes;
+
+/* t_oproc: called by the line discipline with the tty locked. bt_tx only copies into the UART worker's ring. */
+static void
+bt_start(struct tty *tp)
+{
+	uint8_t chunk[128];
+	if (tp->t_state & (TS_TIMEOUT | TS_BUSY | TS_TTSTOP)) {
+		return;
+	}
+	while (tp->t_outq.c_cc > 0 && bt_tx) {
+		int room = bt_tx(NULL, 0);
+		if (room <= 0) {
+			break;          /* the UART side kicks us when its ring drains */
+		}
+		int n = q_to_b(&tp->t_outq, chunk, room < (int)sizeof chunk ? room : (int)sizeof chunk);
+		if (n <= 0) {
+			break;
+		}
+		int sent = bt_tx(chunk, (uint32_t)n);
+		if (sent > 0) {
+			bt_tx_bytes += (uint32_t)sent;
+		}
+	}
+	ttwwakeup(tp);
+}
+
+/* The UART runs at the speed the kernel set up for the firmware download; termios speed changes are accepted and recorded. */
+static int
+bt_param(struct tty *tp, struct termios *t)
+{
+	tp->t_ispeed = t->c_ispeed;
+	tp->t_ospeed = t->c_ospeed;
+	tp->t_cflag = t->c_cflag;
+	return 0;
+}
+
+static int
+bt_open(dev_t dev, int flag, __unused int devtype, __unused proc_t p)
+{
+	struct tty *tp = bt_tty;
+	int error;
+	if (tp == NULL) {
+		return ENXIO;
+	}
+	tty_lock(tp);
+	if ((tp->t_state & TS_ISOPEN) == 0) {
+		termioschars(&tp->t_termios);
+		tp->t_iflag = 0;
+		tp->t_oflag = 0;
+		tp->t_lflag = 0;
+		tp->t_cflag = CS8 | CREAD | CLOCAL;
+		tp->t_ispeed = tp->t_ospeed = 115200;
+		ttsetwater(tp);
+	}
+	tp->t_dev = dev;
+	tp->t_oproc = bt_start;
+	tp->t_param = bt_param;
+	tp->t_state |= TS_CARR_ON;
+	error = (*linesw[tp->t_line].l_open)(dev, tp);
+	tty_unlock(tp);
+	printf("ZIZHAN_BT_UART: open flag=%x error=%d\n", flag, error);
+	return error;
+}
+
+static int
+bt_close(__unused dev_t dev, int flag, __unused int mode, __unused proc_t p)
+{
+	struct tty *tp = bt_tty;
+	if (tp == NULL) {
+		return ENXIO;
+	}
+	tty_lock(tp);
+	(*linesw[tp->t_line].l_close)(tp, flag);
+	ttyclose(tp);
+	tty_unlock(tp);
+	printf("ZIZHAN_BT_UART: close tx=%u rx=%u rx_dropped=%u\n", bt_tx_bytes, bt_rx_bytes, bt_rx_dropped);
+	return 0;
+}
+
+static int
+bt_read(__unused dev_t dev, struct uio *uio, int flag)
+{
+	struct tty *tp = bt_tty;
+	int error;
+	if (tp == NULL) {
+		return ENXIO;
+	}
+	tty_lock(tp);
+	error = (*linesw[tp->t_line].l_read)(tp, uio, flag);
+	tty_unlock(tp);
+	return error;
+}
+
+static int
+bt_write(__unused dev_t dev, struct uio *uio, int flag)
+{
+	struct tty *tp = bt_tty;
+	int error;
+	if (tp == NULL) {
+		return ENXIO;
+	}
+	tty_lock(tp);
+	error = (*linesw[tp->t_line].l_write)(tp, uio, flag);
+	tty_unlock(tp);
+	return error;
+}
+
+static int
+bt_ioctl(__unused dev_t dev, u_long cmd, caddr_t data, int flag, proc_t p)
+{
+	struct tty *tp = bt_tty;
+	int error;
+	if (tp == NULL) {
+		return ENXIO;
+	}
+	tty_lock(tp);
+	error = (*linesw[tp->t_line].l_ioctl)(tp, cmd, data, flag, p);
+	if (error == ENOTTY) {
+		error = ttioctl_locked(tp, cmd, data, flag, p);
+	}
+	tty_unlock(tp);
+	return error;
+}
+
+static int
+bt_select(__unused dev_t dev, int which, void *wql, proc_t p)
+{
+	struct tty *tp = bt_tty;
+	int ready;
+	if (tp == NULL) {
+		return ENXIO;
+	}
+	/* ttselect() takes the tty lock itself (bt-35: recursive lock panic from bluetoothd select()); ttyselect() wants it held. */
+	tty_lock(tp);
+	ready = ttyselect(tp, which, wql, p);
+	tty_unlock(tp);
+	return ready;
+}
+
+static struct tty *bt_ttys[1];
+
+static int
+bt_stop(__unused struct tty *tp, __unused int rw)
+{
+	return 0;
+}
+
+static const struct cdevsw bt_cdevsw = {
+	.d_open = bt_open, .d_close = bt_close, .d_read = bt_read, .d_write = bt_write,
+	.d_ioctl = bt_ioctl, .d_stop = bt_stop, .d_reset = eno_reset,
+	.d_ttys = bt_ttys, .d_select = bt_select, .d_mmap = eno_mmap, .d_strategy = eno_strat,
+	.d_reserved_1 = eno_getc, .d_reserved_2 = eno_putc, .d_type = D_TTY,
+};
+
+/*
+ * /dev/btreset, /dev/btwake, /dev/btpoweroff: the J171 kext AppleBluetooth (class BTReset) asserts the GPIO while the node is
+ * open and deasserts it on close; BlueTool opens them around its controller bring-up. Here the kernel owns the QCA6490
+ * power and firmware, so the nodes only record the request (zizhan_bt_ctrl_state(): bit 0 reset, 1 wake, 2 power-off held).
+ */
+static uint32_t bt_ctrl_bits, bt_ctrl_opens[3];
+static int bt_ctrl_major = -1;
+static const char *const bt_ctrl_names[3] = { "btreset", "btwake", "btpoweroff" };
+uint32_t zizhan_bt_ctrl_state(void);
+uint32_t
+zizhan_bt_ctrl_state(void)
+{
+	return __atomic_load_n(&bt_ctrl_bits, __ATOMIC_ACQUIRE);
+}
+static int
+bt_ctrl_open(dev_t dev, __unused int flag, __unused int devtype, __unused proc_t p)
+{
+	const int m = minor(dev);
+	if (m < 0 || m > 2) {
+		return ENXIO;
+	}
+	__atomic_fetch_or(&bt_ctrl_bits, 1u << m, __ATOMIC_ACQ_REL);
+	bt_ctrl_opens[m]++;
+	printf("ZIZHAN_BT_CTRL: open %s (assert) count=%u\n", bt_ctrl_names[m], bt_ctrl_opens[m]);
+	return 0;
+}
+static int
+bt_ctrl_close(dev_t dev, __unused int flag, __unused int mode, __unused proc_t p)
+{
+	const int m = minor(dev);
+	if (m < 0 || m > 2) {
+		return ENXIO;
+	}
+	__atomic_fetch_and(&bt_ctrl_bits, ~(1u << m), __ATOMIC_ACQ_REL);
+	printf("ZIZHAN_BT_CTRL: close %s (deassert)\n", bt_ctrl_names[m]);
+	return 0;
+}
+static const struct cdevsw bt_ctrl_cdevsw = {
+	.d_open = bt_ctrl_open, .d_close = bt_ctrl_close, .d_read = eno_rdwrt, .d_write = eno_rdwrt,
+	.d_ioctl = eno_ioctl, .d_stop = eno_stop, .d_reset = eno_reset, .d_ttys = NULL, .d_select = eno_select,
+	.d_mmap = eno_mmap, .d_strategy = eno_strat, .d_reserved_1 = eno_getc, .d_reserved_2 = eno_putc, .d_type = 0,
+};
+
+/*
+ * iOS 18 BlueTool opens the default device ("device -D") as the kernel control "com.apple.uart.bluetooth" (PF_SYSTEM,
+ * SOCK_STREAM): read/write carry the H4 bytes and getsockopt/setsockopt(SYSPROTO_CONTROL, TIOCGETA/TIOCSETA) carry a
+ * struct termios. This control feeds the same transmit hook as the tty and receives the same controller bytes.
+ */
+extern void IOSleep(unsigned int milliseconds);
+static kern_ctl_ref bt_kctl_ref;
+static uint32_t bt_kctl_unit, bt_kctl_connected, bt_kctl_tx, bt_kctl_rx, bt_kctl_rx_dropped;
+static struct termios bt_kctl_termios;
+
+static errno_t
+bt_kctl_connect(kern_ctl_ref ref, struct sockaddr_ctl *sac, void **unitinfo)
+{
+	(void)ref;
+	*unitinfo = NULL;
+	bt_kctl_unit = sac->sc_unit;
+	__atomic_store_n(&bt_kctl_connected, 1, __ATOMIC_RELEASE);
+	printf("ZIZHAN_BT_KCTL: connect unit=%u\n", sac->sc_unit);
+	return 0;
+}
+static errno_t
+bt_kctl_disconnect(kern_ctl_ref ref, u_int32_t unit, void *unitinfo)
+{
+	(void)ref; (void)unitinfo;
+	__atomic_store_n(&bt_kctl_connected, 0, __ATOMIC_RELEASE);
+	printf("ZIZHAN_BT_KCTL: disconnect unit=%u tx=%u rx=%u rx_dropped=%u\n", unit, bt_kctl_tx, bt_kctl_rx, bt_kctl_rx_dropped);
+	return 0;
+}
+static errno_t
+bt_kctl_send(kern_ctl_ref ref, u_int32_t unit, void *unitinfo, mbuf_t m, int flags)
+{
+	(void)ref; (void)unit; (void)unitinfo; (void)flags;
+	for (mbuf_t n = m; n != NULL; n = mbuf_next(n)) {
+		const uint8_t *data = mbuf_data(n);
+		size_t len = mbuf_len(n), done = 0;
+		for (unsigned tries = 0; done < len && bt_tx && tries < 200; ) {
+			int room = bt_tx(NULL, 0);
+			if (room <= 0) { IOSleep(1); tries++; continue; }
+			size_t chunk = len - done < (size_t)room ? len - done : (size_t)room;
+			int sent = bt_tx(data + done, (uint32_t)chunk);
+			if (sent > 0) { done += (size_t)sent; bt_kctl_tx += (uint32_t)sent; }
+		}
+	}
+	mbuf_freem(m);
+	return 0;
+}
+static errno_t
+bt_kctl_setopt(kern_ctl_ref ref, u_int32_t unit, void *unitinfo, int opt, void *data, size_t len)
+{
+	(void)ref; (void)unit; (void)unitinfo;
+	if ((unsigned)opt == (unsigned)TIOCSETA && data && len >= sizeof(struct termios)) {
+		memcpy(&bt_kctl_termios, data, sizeof(struct termios));
+		printf("ZIZHAN_BT_KCTL: TIOCSETA speed=%lu cflag=%lx (UART stays at its fixed speed)\n",
+		    (unsigned long)bt_kctl_termios.c_ospeed, (unsigned long)bt_kctl_termios.c_cflag);
+		return 0;
+	}
+	printf("ZIZHAN_BT_KCTL: setopt opt=%x len=%zu (accepted)\n", (unsigned)opt, len);
+	return 0;
+}
+static errno_t
+bt_kctl_getopt(kern_ctl_ref ref, u_int32_t unit, void *unitinfo, int opt, void *data, size_t *len)
+{
+	(void)ref; (void)unit; (void)unitinfo;
+	if ((unsigned)opt == (unsigned)TIOCGETA && len) {
+		if (data && *len >= sizeof(struct termios)) memcpy(data, &bt_kctl_termios, sizeof(struct termios));
+		*len = sizeof(struct termios);
+		return 0;
+	}
+	printf("ZIZHAN_BT_KCTL: getopt opt=%x (empty)\n", (unsigned)opt);
+	if (len) *len = 0;
+	return 0;
+}
+static void
+bt_kctl_register(void)
+{
+	struct kern_ctl_reg reg;
+	bzero(&reg, sizeof(reg));
+	strlcpy(reg.ctl_name, "com.apple.uart.bluetooth", sizeof(reg.ctl_name));
+	reg.ctl_flags = CTL_FLAG_REG_SOCK_STREAM;   /* not privileged: BlueTool runs as mobile */
+	reg.ctl_sendsize = 64 * 1024;
+	reg.ctl_recvsize = 64 * 1024;
+	reg.ctl_connect = bt_kctl_connect;
+	reg.ctl_disconnect = bt_kctl_disconnect;
+	reg.ctl_send = bt_kctl_send;
+	reg.ctl_setopt = bt_kctl_setopt;
+	reg.ctl_getopt = bt_kctl_getopt;
+	bzero(&bt_kctl_termios, sizeof(bt_kctl_termios));
+	bt_kctl_termios.c_cflag = CS8 | CREAD | CLOCAL;
+	bt_kctl_termios.c_ispeed = bt_kctl_termios.c_ospeed = 115200;
+	const errno_t err = ctl_register(&reg, &bt_kctl_ref);
+	printf("ZIZHAN_BT_KCTL: register com.apple.uart.bluetooth err=%d id=%u\n", err, reg.ctl_id);
+}
+
+int
+zizhan_bt_uart_attach(zizhan_bt_tx_t tx)
+{
+	if (bt_tty != NULL || tx == NULL) {
+		return EBUSY;
+	}
+	struct tty *tp = ttymalloc();
+	if (tp == NULL) {
+		return ENOMEM;
+	}
+	bt_major = cdevsw_add(-24, &bt_cdevsw);
+	if (bt_major < 0) {
+		ttyfree(tp);
+		return ENXIO;
+	}
+	if (cdevsw_setkqueueok(bt_major, &bt_cdevsw, CDEVSW_SELECT_KQUEUE) == -1) {
+		printf("ZIZHAN_BT_UART: kqueue not enabled (select only)\n");
+	}
+	bt_tx = tx;
+	bt_ttys[0] = tp;
+	bt_tty = tp;
+	void *cu = devfs_make_node(makedev(bt_major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "cu.bluetooth");
+	void *uart = devfs_make_node(makedev(bt_major, 0), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "uart.bluetooth");
+	bt_kctl_register();
+	bt_ctrl_major = cdevsw_add(-24, &bt_ctrl_cdevsw);
+	unsigned ctrl = 0;
+	for (int m = 0; bt_ctrl_major >= 0 && m < 3; ++m) {
+		if (devfs_make_node(makedev(bt_ctrl_major, m), DEVFS_CHAR, UID_ROOT, GID_WHEEL, 0666, "%s", bt_ctrl_names[m])) {
+			ctrl++;
+		}
+	}
+	printf("ZIZHAN_BT_UART: attached major=%d cu=%u uart=%u ctrl_major=%d ctrl_nodes=%u\n", bt_major, cu ? 1u : 0u, uart ? 1u : 0u,
+	    bt_ctrl_major, ctrl);
+	return (cu || uart) ? 0 : ENXIO;
+}
+
+/* RX from the UART worker thread (not interrupt context). Bytes arriving while nobody has the tty open are dropped. */
+void
+zizhan_bt_uart_input(const uint8_t *buf, uint32_t len)
+{
+	struct tty *tp = bt_tty;
+	if (tp == NULL) {
+		return;
+	}
+	if (buf != NULL && __atomic_load_n(&bt_kctl_connected, __ATOMIC_ACQUIRE) && bt_kctl_ref != NULL) {
+		if (ctl_enqueuedata(bt_kctl_ref, bt_kctl_unit, (void *)(uintptr_t)buf, len, 0) == 0) {
+			bt_kctl_rx += len;
+		} else {
+			bt_kctl_rx_dropped += len;
+		}
+	}
+	tty_lock(tp);
+	if (buf == NULL) {              /* kick: the transmit ring has room again */
+		if ((tp->t_state & TS_ISOPEN) && tp->t_outq.c_cc > 0) {
+			bt_start(tp);
+		}
+		tty_unlock(tp);
+		return;
+	}
+	if ((tp->t_state & TS_ISOPEN) == 0) {
+		bt_rx_dropped += len;
+		tty_unlock(tp);
+		return;
+	}
+	for (uint32_t i = 0; i < len; ++i) {
+		(*linesw[tp->t_line].l_rint)(buf[i], tp);
+	}
+	bt_rx_bytes += len;
+	tty_unlock(tp);
+}
