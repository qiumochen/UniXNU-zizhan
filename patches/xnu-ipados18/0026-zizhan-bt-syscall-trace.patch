+/*
+ * zizhan BT-01 diagnostic: with zizhan_bt_probe>=4, log socket/connect/open of BlueTool and bluetoothd (80 lines each),
+ * to see which transport the iOS 18 Bluetooth stack actually tries on this board. Nothing else changes.
+ */
+#include <pexpert/pexpert.h>
+__private_extern__ int zizhan_bt_trace_proc(proc_t p);
+__private_extern__ int zizhan_bt_trace(proc_t p);
+/* 0 = BlueTool, 1 = bluetoothd, -1 = not traced (no budget used). */
+__private_extern__ int
+zizhan_bt_trace_proc(proc_t p)
+{
+	static int mode = -1;
+	if (mode < 0) {
+		int v = 0;
+		mode = (PE_parse_boot_argn("zizhan_bt_probe", &v, sizeof(v)) && v >= 4) ? 1 : 0;
+	}
+	if (mode != 1 || p == NULL) {
+		return -1;
+	}
+	return strcmp(p->p_comm, "BlueTool") == 0 ? 0 : strcmp(p->p_comm, "bluetoothd") == 0 ? 1 : -1;
+}
+__private_extern__ int
+zizhan_bt_trace(proc_t p)
+{
+	static uint32_t lines[2];
+	const int which = zizhan_bt_trace_proc(p);
+	return which >= 0 && __atomic_fetch_add(&lines[which], 1, __ATOMIC_RELAXED) < 200;
+}
 int
 socket(proc_ref_t p,
     struct socket_args *uap,
     int32_ref_t retval)
 {
-	return socket_common(p, uap->domain, uap->type, uap->protocol,
+	int zz_err = socket_common(p, uap->domain, uap->type, uap->protocol,
 	           proc_selfpid(), retval, 0);
+	if (zizhan_bt_trace(p)) {
+		printf("ZIZHAN_BT_TRACE: %s socket(%d,%d,%d) -> fd=%d err=%d\n", p->p_comm, uap->domain, uap->type, uap->protocol,
+		    zz_err ? -1 : *retval, zz_err);
+	}
+	return zz_err;
 }
 
