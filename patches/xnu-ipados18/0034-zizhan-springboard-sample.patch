+	int pid = -1;
+	proc_iterate(PROC_ALLPROCLIST, synth_springboard_pid, &pid, NULL, NULL);
+	proc_t p = pid > 0 ? proc_find(pid) : PROC_NULL;
+	if (p == PROC_NULL) {
+		sleep_ms(hold_ms);
+		return;
+	}
+	pong_sample_main_thread(proc_task(p), sample_ms ? hold_ms : 0, 2000, flags, tag);
+	proc_rele(p);
+	if (!sample_ms) {
+		sleep_ms(hold_ms);
+	}
+}
