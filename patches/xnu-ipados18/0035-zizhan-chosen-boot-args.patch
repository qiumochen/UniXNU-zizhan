--- a/pexpert/arm/pe_bootargs.c
+++ b/pexpert/arm/pe_bootargs.c
@@ -3,10 +3,60 @@
  */
 #include <pexpert/pexpert.h>
 #include <pexpert/boot.h>
+#include <pexpert/device_tree.h>
+#include <string.h>
+
+/*
+ * zizhan (2026-11-23): DarwinBoot passes at most 1023 command-line bytes (BOOT_LINE_LENGTH), and the daily arguments plus a
+ * test round's switches no longer fit. Extra arguments may come as the /chosen property "zizhan-boot-args" (a string the
+ * boot image packs into the ADT). PE_init_platform calls zizhan_boot_args_extend() right after the device tree is set up;
+ * from then on PE_boot_args() (PE_parse_boot_argn, sysctl kern.zizhan_bootargs) is the command line padded with spaces to
+ * 1024 bytes, then the extra arguments; kern.bootargs stays the command line alone. Arguments parsed before PE_init_platform,
+ * DarwinBoot's own (pong_autoreset) and those userland reads from kern.bootargs must stay on the command line.
+ */
+static char zizhan_boot_args_all[2048];
+static int zizhan_boot_args_ready;
+
+void zizhan_boot_args_extend(void);
+void
+zizhan_boot_args_extend(void)
+{
+	DTEntry entry;
+	void const *prop = NULL;
+	unsigned int size = 0;
+	const char *base = (const char *)((boot_args *)PE_state.bootArgs)->CommandLine;
+	if (zizhan_boot_args_ready || SecureDTLookupEntry(NULL, "/chosen", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "zizhan-boot-args", &prop, &size) != kSuccess || prop == NULL || size == 0) {
+		return;
+	}
+	const char *extra = (const char *)prop;
+	size_t n = strnlen(base, BOOT_LINE_LENGTH - 1);
+	memcpy(zizhan_boot_args_all, base, n);
+	while (n < BOOT_LINE_LENGTH) {
+		zizhan_boot_args_all[n++] = ' ';
+	}
+	for (unsigned int i = 0; i < size && extra[i] != '\0' && n < sizeof(zizhan_boot_args_all) - 1; i++) {
+		const char c = extra[i];
+		zizhan_boot_args_all[n++] = (c == '\n' || c == '\r' || c == '\t') ? ' ' : c;
+	}
+	zizhan_boot_args_all[n] = '\0';
+	zizhan_boot_args_ready = 1;
+}
+
+/* The command line alone, as DarwinBoot passed it (kern.bootargs). */
+char *PE_boot_args_cmdline(void);
+char *
+PE_boot_args_cmdline(void)
+{
+	return (char *)((boot_args *)PE_state.bootArgs)->CommandLine;
+}
 
 char *
 PE_boot_args(
 	void)
 {
+	if (zizhan_boot_args_ready) {
+		return zizhan_boot_args_all;
+	}
 	return (char *)((boot_args *)PE_state.bootArgs)->CommandLine;
 }
