  * Identical samples share a signature; the timeline prints one character per sample and each signature its share, for
  * dscsym.py --addr/--slide. flags: 1 = start a new window, 2 = print the window. Only the synthetic-touch thread calls this.
  */
+/*
+ * zizhan_sample_ipi=1 (UX-07): the saved user state of a running thread is only as fresh as its last kernel entry, so a
+ * thread back in user mode after a system call still shows the call's stub. With this boot-arg a running sample is taken
+ * on the thread's own CPU by a cross-call: the interrupted pc is the truth, in user mode (pc, lr, frame chain walked by the
+ * sampler right after) or in the kernel (kernel backtrace, plus the user pc of the trap that entered it).
+ */
+enum { kPongSampleDepth = 8, kPongSampleDeep = 160 };
+/* osfmk/kern/thread_act.c; the MIG header is not for this file */
+extern kern_return_t thread_suspend(thread_t thread);
+extern kern_return_t thread_resume(thread_t thread);
+struct pong_sample_req {
+	thread_t target;
+	volatile uint32_t done;         /* 1 user, 2 kernel, 3 another thread was on the CPU, 4 no interrupted state */
+	uint32_t nkbt;
+	uint64_t pc, lr, fp, sp;
+	uintptr_t kbt[kPongSampleDepth];
+};
+
+static void
+pong_sample_xcall(void *param)
+{
+	struct pong_sample_req *req = param;
+	const arm_saved_state_t *state = getCpuDatap()->cpu_int_state;
+	uint32_t done;
+
+	if (current_thread() != req->target) {
+		done = 3;
+	} else if (state == NULL) {
+		done = 4;
+	} else {
+		req->pc = get_saved_state_pc(state);
+		req->lr = get_saved_state_lr(state);
+		req->fp = get_saved_state_fp(state);
+		req->sp = get_saved_state_sp(state);
+		if (PSR64_IS_KERNEL(get_saved_state_cpsr(state))) {
+			struct backtrace_control ctl = BTCTL_INIT;
+			ctl.btc_flags = BTF_KERN_INTERRUPTED;
+			req->nkbt = backtrace(req->kbt, kPongSampleDepth, &ctl, NULL);
+			done = 2;
+		} else {
+			done = 1;
+		}
+	}
+	os_atomic_store(&req->done, done, release);
+}
+
+static void
+pong_sample_walk(vm_map_t map, uint64_t fp, uint64_t sp, uint64_t *ra, unsigned depth)
+{
+	const uint64_t mask = 0x0000007fffffffffULL;
+
+	for (unsigned d = 0; d < depth; d++) {
+		uint64_t frame[2] = { 0, 0 };
+		if (fp < sp || fp - sp > 8 * 1024 * 1024 || (fp & 15) ||
+		    copyinmap(map, (vm_map_offset_t)fp, frame, sizeof(frame)) != KERN_SUCCESS) {
+			break;
+		}
+		ra[d] = frame[1] & mask;
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+}
