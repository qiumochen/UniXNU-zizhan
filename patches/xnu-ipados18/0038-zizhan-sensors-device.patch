zizhan SENS-03: /dev/zizhan-sensors, a third input queue for the sensor DSP samples (zizhan_sensor_post, zizhan_sensors_device_ready).
--- a/bsd/dev/pong_input.c
+++ b/bsd/dev/pong_input.c
@@ -23,7 +23,8 @@
     uint32_t head,tail;
     bool opened,ready;
 };
-static struct input_queue queues[2];
+/* 0 touch, 1 buttons, 2 sensors (zizhan SENS-03: /dev/zizhan-sensors, samples of the sensor DSP for the HID bridge) */
+static struct input_queue queues[3];
 static int input_major=-1;
 
 void
@@ -40,11 +41,23 @@
     wakeup(q);
 }
 
+/* One sensor sample: kind in type (ZIZHAN_SENSOR_*), three signed values in finger, x and y. A slow reader loses the oldest. */
+void
+zizhan_sensor_post(uint32_t kind,int32_t a,int32_t b,int32_t c)
+{
+    struct input_queue *q=&queues[2];
+    lck_mtx_lock(&touch_lock);
+    if (q->tail-q->head==QUEUE_SIZE) q->head++;
+    q->samples[q->tail++%QUEUE_SIZE]=(struct pong_touch){mach_absolute_time(),kind,(uint32_t)a,(uint32_t)b,(uint32_t)c};
+    lck_mtx_unlock(&touch_lock);
+    wakeup(q);
+}
+
