+static thread_t
+pong_sample_pick_thread(task_t task, unsigned n)
+{
+	thread_t chosen = THREAD_NULL, runnable = THREAD_NULL, t = THREAD_NULL;
+	unsigned active_n = 0;
+
+	task_lock(task);
+	queue_iterate(&task->threads, t, thread_t, task_threads) {
+		const processor_t last = t->last_processor;
+		if (!(t->state & TH_WAIT) && last != PROCESSOR_NULL && last->active_thread == t) {
+			active_n++;
+			if (chosen == THREAD_NULL || (n % active_n) == 0) {
+				chosen = t;
+			}
+		} else if (runnable == THREAD_NULL && !(t->state & TH_WAIT)) {
+			runnable = t;
+		}
+	}
+	if (chosen == THREAD_NULL) {
+		if (runnable != THREAD_NULL) {
+			chosen = runnable;
+		} else if (!queue_empty(&task->threads)) {
+			chosen = (thread_t)queue_first(&task->threads);
+		}
+	}
+	if (chosen != THREAD_NULL) {
+		thread_reference(chosen);
+	}
+	task_unlock(task);
+	return chosen;
+}
