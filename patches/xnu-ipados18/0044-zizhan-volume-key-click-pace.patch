+unsigned pong_volume_key_sample(uint32_t code,int down,uint32_t dt_ms);
+unsigned
+pong_volume_key_sample(uint32_t code,int down,uint32_t dt_ms)
+{
+    if (code!=PONG_BUTTON_VOLUME_UP && code!=PONG_BUTTON_VOLUME_DOWN) {
+        return 0;
+    }
+    unsigned idx=(code==PONG_BUTTON_VOLUME_UP)?0u:1u;
+    if (!down) {
+        vol_state[idx].down=0;
+        vol_state[idx].held_ms=0;
+        return 0;
+    }
+    unsigned fire=0;
+    if (!vol_state[idx].down) {
+        vol_state[idx].down=1;
+        vol_state[idx].held_ms=0;
+        fire=1;
+    } else {
+        uint32_t prev=vol_state[idx].held_ms;
+        uint32_t next=(dt_ms>0xffffu-prev)?0xffffu:(prev+dt_ms);
+        vol_state[idx].held_ms=next;
+        if (next>=400u) {
+            if (prev<400u || (next-400u)/112u>(prev-400u)/112u) {
+                fire=1;
+            }
+        }
+    }
+    if (fire) {
+        pong_touch_post(PONG_BUTTON_DOWN,code,0,0);
+        pong_touch_post(PONG_BUTTON_UP,code,0,0);
+    }
+    return fire;
+}
+
 static void look(struct key *k,bool down)
 {
     bool steady=k->last==down;k->last=down;
