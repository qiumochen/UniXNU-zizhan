diff --git a/bsd/dev/pong_buttons.c b/bsd/dev/pong_buttons.c
index cbe0c0c..dfc4734 100644
--- a/bsd/dev/pong_buttons.c
+++ b/bsd/dev/pong_buttons.c
@@ -23,6 +23,7 @@ static uint64_t power_down_at;
 static bool reset_fired;
 static uint32_t vol_pace=1;
 static struct {uint32_t held_ms;uint8_t down;} vol_state[2];
+static volatile int swallow_power;
 static vm_offset_t core,cnfg,observer;
 static bool v7;
 static uint32_t channels;
@@ -165,7 +166,12 @@ static void keys_thread(__unused void *arg,__unused wait_result_t result)
         bool was_vol_down[3]={false,keys[1].down,keys[2].down};
         if (keys[0].usable) {
             if (read_registers(&pon,0x10,&state,1)) {
-                look(&keys[0],(state&0x80)!=0);look(&keys[2],(state&0x40)!=0);
+                bool pdown=(state&0x80)!=0;
+                if (__atomic_load_n(&swallow_power,__ATOMIC_ACQUIRE)) {
+                    if (!pdown) __atomic_store_n(&swallow_power,0,__ATOMIC_RELEASE);
+                    pdown=false;
+                }
+                look(&keys[0],pdown);look(&keys[2],(state&0x40)!=0);
             } else good=false;
         }
         if (keys[1].usable) {
@@ -234,4 +240,40 @@ void pong_buttons_init(void)
     PE_parse_boot_argn("zizhan_vol_pace",&vol_pace,sizeof(vol_pace));
     if (kernel_thread_start(keys_thread,NULL,&t)==KERN_SUCCESS) thread_deallocate(t);
 }
+
+int pong_buttons_ready(void);
+int
+pong_buttons_ready(void)
+{
+    return keys[0].usable ? 1 : 0;
+}
+
+/* Called on the boot core with interrupts masked during platform sleep (ZizhanSleep.h).
+ * Uses raw CNTVCT_EL0 ticks (2 ms timeout) instead of Mach deadlines so it is safe while
+ * rtclock is quiesced. Read-only SPMI observer access to PMK8350 PON RT_STS (0x10). */
+int pong_buttons_sleep_check(void);
+int
+pong_buttons_sleep_check(void)
+{
+    if (!keys[0].usable || !pon.found || !observer) return 0;
+    vm_offset_t ch=observer+(v7?0x20UL:0x80UL)*pon.channel;
+    uint64_t hz=0,start=0,now=0;
+    __asm__ volatile("mrs %0, cntfrq_el0" : "=r"(hz));
+    if (!hz) hz=19200000ULL;
+    __asm__ volatile("isb\n\tmrs %0, cntvct_el0" : "=r"(start));
+    const uint64_t budget=hz/500ULL; /* 2 ms */
+    wr(ch,(1u<<27)|(0x10u<<4)|0u);
+    uint32_t status=0;
+    do {
+        status=rd(ch+8);
+        __asm__ volatile("isb\n\tmrs %0, cntvct_el0" : "=r"(now));
+    } while (!(status&1u) && (now-start)<budget);
+    if ((status&0xfu)!=1u) return 0;
+    const uint8_t rt=(uint8_t)(rd(ch+0x18)&0xffu);
+    if ((rt&0x80u)!=0u) {
+        __atomic_store_n(&swallow_power,1,__ATOMIC_RELEASE);
+        return 1;
+    }
+    return 0;
+}
 #endif
