diff --git a/osfmk/arm/cpu_common.c b/osfmk/arm/cpu_common.c
index 1955f09..af9f099 100644
--- a/osfmk/arm/cpu_common.c
+++ b/osfmk/arm/cpu_common.c
@@ -850,6 +850,29 @@ ml_wait_for_cpu_signal_to_enable(void)
 	assert(ml_get_interrupts_enabled());
 	cpu_data_t *cpu_data_ptr = getCpuDatap();
 
+#if defined(__arm64__)
+	/*
+	 * zizhan POWER-02: with platform sleep installed, the boot core resumes alone before secondary cores are
+	 * started; if a self-IPI races, clear SIGPdisabled after 100 ms once InitState|StartedState & cpu_running hold.
+	 */
+	extern void (*arm64_platform_sleep_hook)(boolean_t boot_cpu);
+	if (arm64_platform_sleep_hook != NULL) {
+		uint64_t deadline;
+		nanoseconds_to_absolutetime(100 * NSEC_PER_MSEC, &deadline);
+		deadline += mach_absolute_time();
+		while (os_atomic_load(&cpu_data_ptr->cpu_signal, acquire) == SIGPdisabled) {
+			if (mach_absolute_time() > deadline) {
+				if ((os_atomic_load(&cpu_data_ptr->cpu_flags, relaxed) & (InitState | StartedState)) ==
+				    (InitState | StartedState) &&
+				    os_atomic_load(&cpu_data_ptr->cpu_running, relaxed)) {
+					os_atomic_andnot(&cpu_data_ptr->cpu_signal, SIGPdisabled, acq_rel);
+				}
+				break;
+			}
+		}
+		return;
+	}
+#endif /* defined(__arm64__) */
 	hw_wait_while_equals32(__DEVOLATILE(uint32_t*, &cpu_data_ptr->cpu_signal), SIGPdisabled);
 }
 
diff --git a/osfmk/arm64/cpu.c b/osfmk/arm64/cpu.c
index 8ab199b..f241b4d 100644
--- a/osfmk/arm64/cpu.c
+++ b/osfmk/arm64/cpu.c
@@ -103,6 +103,13 @@ extern void __attribute__((noreturn)) arm64_prepare_for_sleep(boolean_t deep_sle
 #else
 extern void __attribute__((noreturn)) arm64_prepare_for_sleep(boolean_t deep_sleep);
 #endif
+/*
+ * zizhan POWER-02 (adapted from UniXNU-sheng): platform sleep hook for boards without Apple's sleep hardware.
+ * Non-boot cores call arm64_platform_sleep_hook(FALSE) and turn off via PSCI CPU_OFF; the boot core calls
+ * arm64_platform_sleep_hook(TRUE) with interrupts masked, waits for a registered wake source or timer, and
+ * resumes through arm_init_cpu(cpu_data_ptr, 0).
+ */
+void (*arm64_platform_sleep_hook)(boolean_t boot_cpu) = NULL;
 extern void arm64_force_wfi_clock_gate(void);
 #if defined(APPLETYPHOON)
 // <rdar://problem/15827409>
@@ -1098,6 +1105,10 @@ ml_arm_sleep(void)
 #if CONFIG_CPU_COUNTERS
 		mt_sleep();
 #endif /* CONFIG_CPU_COUNTERS */
+		if (arm64_platform_sleep_hook != NULL) {
+			arm64_platform_sleep_hook(TRUE);
+			arm_init_cpu(cpu_data_ptr, 0);
+		}
 		/* ARM64-specific preparation */
 #if APPLEVIRTUALPLATFORM
 		extern bool test_sleep_in_vm;
@@ -1140,6 +1151,9 @@ ml_arm_sleep(void)
 			*(volatile uint32_t *)(cpu_data_ptr->coresight_base[CORESIGHT_ED] + ARM_DEBUG_OFFSET_DBGPRCR) = 0;
 		}
 
+		if (arm64_platform_sleep_hook != NULL) {
+			arm64_platform_sleep_hook(FALSE);
+		}
 		/* ARM64-specific preparation */
 #if APPLEVIRTUALPLATFORM
 		arm64_prepare_for_sleep(true, cpu_data_ptr->cpu_number, ml_vtophys(reset_vector_vaddr));
