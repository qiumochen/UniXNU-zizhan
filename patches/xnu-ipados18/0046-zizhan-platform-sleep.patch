@@ -12969,3 +12986,42 @@ IOPMrootDomain::sleepWakeDebugSaveFile(const char *name, char *buf, int len)
 
 #endif /* defined(__i386__) || defined(__x86_64__) */
 
+#if defined(__arm64__)
+extern "C" int
+zizhan_pmrd_boot_complete(void)
+{
+	if (!gRootDomain) {
+		return -1;
+	}
+	return (gRootDomain->receivePowerNotification(0x5a495a42u) == kIOReturnSuccess) ? 0 : -2;
+}
+
+extern "C" int
+zizhan_pmrd_request_sleep(void)
+{
+	if (!gRootDomain) {
+		return -1;
+	}
+	if (gSleepDisabledFlag) {
+		IOLog("PMRD: zizhan_pmrd_request_sleep refused (sleep_disabled=%u)\n", gSleepDisabledFlag);
+		return -2;
+	}
+	gRootDomain->receivePowerNotification(kIOPMSleepNow);
+	return 0;
+}
+
+extern "C" void
+zizhan_pmrd_claim_wake(const char *reason, int user_active)
+{
+	if (!gRootDomain) {
+		return;
+	}
+	const char *why = reason ? reason : "zizhan wake";
+	gRootDomain->claimSystemWakeEvent(gRootDomain, kIOPMWakeEventSource, why);
+	if (user_active) {
+		gRootDomain->requestUserActive(gRootDomain, why);
+	}
+}
+#endif /* defined(__arm64__) */
+
