+
+static bool
+zizhan_exec_wants_app_adapter(struct image_params *imgp, const char *name, size_t namelen)
+{
+	uint32_t enabled = zizhan_inject_apps;
+	if (!enabled) {
+		(void)PE_parse_boot_argn("zizhan_inject_apps", &enabled, sizeof(enabled));
+		if (enabled) {
+			zizhan_inject_apps = enabled;
+		}
+	}
+	if (!enabled || name == NULL) {
+		return false;
+	}
+	if ((namelen == 6 && strncmp(name, "Camera", 6) == 0) ||
+	    (namelen == 8 && strncmp(name, "FaceTime", 8) == 0) ||
+	    (namelen == 12 && strncmp(name, "MobileSafari", 12) == 0) ||
+	    (namelen == 15 && strncmp(name, "ZizhanInstaller", 15) == 0)) {
+		return true;
+	}
+	if (imgp->ip_strings != NULL &&
+	    strncmp(imgp->ip_strings, EXECUTABLE_KEY, sizeof(EXECUTABLE_KEY) - 1) == 0) {
+		const char *ep = imgp->ip_strings + (sizeof(EXECUTABLE_KEY) - 1);
+		const char kPfx1[] = "/private/var/containers/Bundle/Application/";
+		const char kPfx2[] = "/var/containers/Bundle/Application/";
+		if ((strncmp(ep, kPfx1, sizeof(kPfx1) - 1) == 0 ||
+		    strncmp(ep, kPfx2, sizeof(kPfx2) - 1) == 0) &&
+		    strnstr(ep, ".app/", MAXPATHLEN) != NULL && strnstr(ep, ".appex/", MAXPATHLEN) == NULL) {
+			return true;
+		}
+	}
+	return false;
+}
