+
+static zizhan_cam_ctrl_fn cam_ctrl_cb;
+static zizhan_cam_frame_fn cam_frame_cb;
+
+void
+zizhan_cam_register(zizhan_cam_ctrl_fn ctrl_fn, zizhan_cam_frame_fn frame_fn)
+{
+    lck_mtx_lock(&node_lock);
+    cam_ctrl_cb = ctrl_fn;
+    cam_frame_cb = frame_fn;
+    lck_mtx_unlock(&node_lock);
+}
+
+static int
+sysctl_zizhan_cam_ctrl(__unused struct sysctl_oid *oidp, __unused void *arg1,
+    __unused int arg2, struct sysctl_req *req)
+{
+    zizhan_cam_ctrl_fn fn;
+    lck_mtx_lock(&node_lock);
+    fn = cam_ctrl_cb;
+    lck_mtx_unlock(&node_lock);
+    int val = fn ? fn(-1) : 0;
+    int error = sysctl_handle_int(oidp, &val, 0, req);
+    if (error || req->newptr == USER_ADDR_NULL) {
+        return error;
+    }
+    return fn ? fn(val) : ENXIO;
+}
+SYSCTL_PROC(_kern, OID_AUTO, zizhan_cam_ctrl,
+    CTLTYPE_INT | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    0, 0, sysctl_zizhan_cam_ctrl, "I", "zizhan camera lease control");
+
+static int
+sysctl_zizhan_cam_frame(__unused struct sysctl_oid *oidp, __unused void *arg1,
+    __unused int arg2, struct sysctl_req *req)
+{
+    if (req->newptr != USER_ADDR_NULL) {
+        return EPERM;
+    }
+    zizhan_cam_frame_fn fn;
+    lck_mtx_lock(&node_lock);
+    fn = cam_ctrl_cb ? cam_frame_cb : NULL;
+    lck_mtx_unlock(&node_lock);
+    if (!fn) {
+        return ENXIO;
+    }
+    size_t total = fn(NULL, 0, 0);
+    if (total == 0) {
+        return EAGAIN;
+    }
+    if (req->oldptr == USER_ADDR_NULL) {
+        return SYSCTL_OUT(req, NULL, total);
+    }
+    const size_t kChunk = 16384;
+    void *buf = kalloc_data(kChunk, Z_WAITOK | Z_ZERO);
+    if (!buf) {
+        return ENOMEM;
+    }
+    size_t limit = req->oldlen < total ? req->oldlen : total;
+    size_t off = 0;
+    int error = 0;
+    while (off < limit) {
+        size_t want = limit - off;
+        if (want > kChunk) {
+            want = kChunk;
+        }
+        size_t got = fn(buf, want, off);
+        if (got == 0) {
+            break;
+        }
+        error = SYSCTL_OUT(req, buf, got);
+        if (error) {
+            break;
+        }
+        off += got;
+    }
+    kfree_data(buf, kChunk);
+    return error;
+}
+SYSCTL_PROC(_kern, OID_AUTO, zizhan_cam_frame,
+    CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_LOCKED,
+    0, 0, sysctl_zizhan_cam_frame, "-", "zizhan camera frame snapshot");
