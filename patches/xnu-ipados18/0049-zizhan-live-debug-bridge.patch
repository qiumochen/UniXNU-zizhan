+static int
+sysctl_zizhan_dbg_klog(__unused struct sysctl_oid *oidp, __unused void *arg1,
+    __unused int arg2, struct sysctl_req *req)
+{
+    if (!zizhan_dbg_root_authorized()) {
+        return EPERM;
+    }
+    struct {
+        uint64_t since_seq;
+        uint32_t zone;
+        uint32_t max_bytes;
+    } kreq = { 0, 0, 65536U };
+    _Static_assert(sizeof(kreq) == 16, "zizhan klog req");
+    struct {
+        uint64_t total_seq;
+        uint64_t start_seq;
+        uint32_t byte_len;
+        uint32_t dropped;
+    } khdr = { 0, 0, 0, 0 };
+    _Static_assert(sizeof(khdr) == 24, "zizhan klog hdr");
+
+    if (req->newptr != USER_ADDR_NULL) {
+        if (req->newlen != sizeof(kreq)) {
+            return EINVAL;
+        }
+        int err = SYSCTL_IN(req, &kreq, sizeof(kreq));
+        if (err) {
+            return err;
+        }
+    }
+    if (kreq.zone > 1U) {
+        return EINVAL;
+    }
+    size_t cap = kreq.max_bytes ? kreq.max_bytes : 65536U;
+    if (cap > 65536U) {
+        cap = 65536U;
+    }
+    if (req->oldptr == USER_ADDR_NULL) {
+        size_t avail = (kreq.zone == 0U) ?
+            pong_ramoops_read_console(kreq.since_seq, NULL, cap, NULL, NULL, NULL) :
+            pong_ramoops_read_pmsg(kreq.since_seq, NULL, cap, NULL, NULL);
+        return SYSCTL_OUT(req, NULL, sizeof(khdr) + avail);
+    }
+    if (req->oldlen < sizeof(khdr)) {
+        return EINVAL;
+    }
+    size_t out_cap = req->oldlen - sizeof(khdr);
+    if (out_cap < cap) {
+        cap = out_cap;
+    }
+    if (cap == 0) {
+        if (kreq.zone == 0U) {
+            (void)pong_ramoops_read_console(kreq.since_seq, NULL, 0,
+                &khdr.total_seq, &khdr.start_seq, &khdr.dropped);
+        } else {
+            (void)pong_ramoops_read_pmsg(kreq.since_seq, NULL, 0,
+                &khdr.total_seq, &khdr.start_seq);
+        }
+        return SYSCTL_OUT(req, &khdr, sizeof(khdr));
+    }
+    void *buf = kalloc_data(cap, Z_WAITOK | Z_ZERO);
+    if (!buf) {
+        return ENOMEM;
+    }
+    size_t got = (kreq.zone == 0U) ?
+        pong_ramoops_read_console(kreq.since_seq, buf, cap,
+            &khdr.total_seq, &khdr.start_seq, &khdr.dropped) :
+        pong_ramoops_read_pmsg(kreq.since_seq, buf, cap,
+            &khdr.total_seq, &khdr.start_seq);
+    khdr.byte_len = (uint32_t)got;
+    int err = SYSCTL_OUT(req, &khdr, sizeof(khdr));
+    if (!err && got > 0) {
+        err = SYSCTL_OUT(req, buf, got);
+    }
+    kfree_data(buf, cap);
+    return err;
+}
+SYSCTL_PROC(_kern, OID_AUTO, zizhan_dbg_klog,
+    CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    0, 0, sysctl_zizhan_dbg_klog, "-", "zizhan live console/pmsg stream");
+
+static int
+zizhan_dbg_sysctl_emit(void *ctx, const void *data, size_t len)
+{
+    struct sysctl_req *req = (struct sysctl_req *)ctx;
+    if (req->oldidx >= req->oldlen) {
+        return 0;
+    }
+    size_t rem = req->oldlen - req->oldidx;
+    size_t send = len < rem ? len : rem;
+    return send ? SYSCTL_OUT(req, data, send) : 0;
+}
+
+static int
+sysctl_zizhan_dbg_fb(__unused struct sysctl_oid *oidp, __unused void *arg1,
+    __unused int arg2, struct sysctl_req *req)
+{
+    if (!zizhan_dbg_root_authorized()) {
+        return EPERM;
+    }
+    zizhan_dbg_fb_fn fn;
+    lck_mtx_lock(&node_lock);
+    fn = dbg_fb_cb;
+    lck_mtx_unlock(&node_lock);
+    if (!fn) {
+        return ENXIO;
+    }
+    uint8_t fbreq[16] = {};
+    size_t req_len = 0;
+    if (req->newptr != USER_ADDR_NULL) {
+        if (req->newlen != sizeof(fbreq)) {
+            return EINVAL;
+        }
+        int err = SYSCTL_IN(req, fbreq, sizeof(fbreq));
+        if (err) {
+            return err;
+        }
+        req_len = sizeof(fbreq);
+    }
+    size_t total = 0;
+    if (req->oldptr == USER_ADDR_NULL) {
+        int err = fn(req_len ? fbreq : NULL, req_len, NULL, NULL, &total);
+        if (err) {
+            return err;
+        }
+        return SYSCTL_OUT(req, NULL, total);
+    }
+    return fn(req_len ? fbreq : NULL, req_len, zizhan_dbg_sysctl_emit, req, &total);
+}
+SYSCTL_PROC(_kern, OID_AUTO, zizhan_dbg_fb,
+    CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    0, 0, sysctl_zizhan_dbg_fb, "-", "zizhan inner/outer framebuffer snapshot");
+
+static int
+sysctl_zizhan_dbg_ctl(__unused struct sysctl_oid *oidp, __unused void *arg1,
+    __unused int arg2, struct sysctl_req *req)
+{
+    const bool is_root = zizhan_dbg_root_authorized();
+    if (!is_root && !zizhan_dbg_sb_confirm_authorized()) {
+        return EPERM;
+    }
+    zizhan_dbg_ctl_fn fn;
+    lck_mtx_lock(&node_lock);
+    fn = dbg_ctl_cb;
+    lck_mtx_unlock(&node_lock);
+    if (!fn) {
+        return ENXIO;
+    }
+    uint8_t creq[64] = {};
+    size_t req_len = 0;
+    if (req->newptr != USER_ADDR_NULL) {
+        if (req->newlen != sizeof(creq)) {
+            return EINVAL;
+        }
+        int err = SYSCTL_IN(req, creq, sizeof(creq));
+        if (err) {
+            return err;
+        }
+        req_len = sizeof(creq);
+    }
+    if (!is_root) {
+        /* uid=501 MNT_ROOTFS SpringBoard may ONLY send ZIZHAN_DBG_OP_HOT_UI (7) CONFIRM (1) or QUERY (3). */
+        if (req_len != sizeof(creq)) {
+            return EPERM;
+        }
+        uint32_t op = 0, target = 0;
+        memcpy(&op, creq, sizeof(op));
+        memcpy(&target, creq + 4, sizeof(target));
+        if (op != 7U || (target != 1U && target != 3U)) {
+            return EPERM;
+        }
+    }
+    uint8_t cresp[128] = {};
+    size_t resp_len = sizeof(cresp);
+    int err = fn(req_len ? creq : NULL, req_len, cresp, &resp_len);
+    if (err) {
+        return err;
+    }
+    if (req->oldptr == USER_ADDR_NULL) {
+        return SYSCTL_OUT(req, NULL, resp_len);
+    }
+    size_t send = req->oldlen < resp_len ? req->oldlen : resp_len;
+    return send ? SYSCTL_OUT(req, cresp, send) : 0;
+}
+SYSCTL_PROC(_kern, OID_AUTO, zizhan_dbg_ctl,
+    CTLTYPE_OPAQUE | CTLFLAG_RW | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    0, 0, sysctl_zizhan_dbg_ctl, "-", "zizhan live debug control & telemetry");
 #endif
