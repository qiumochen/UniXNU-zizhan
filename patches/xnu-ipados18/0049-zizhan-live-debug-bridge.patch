+/* Stages a validated thin arm64 MH_DYLIB into the inactive root-owned ping-pong slot
+ * (/private/var/db/zizhan-hot-ui-{0,1}.dylib) by unlinking the old inode first and creating
+ * a brand-new inode with O_CREAT | O_EXCL + VNODE_LOOKUP_NOFOLLOW_ANY (never O_TRUNC on a
+ * mapped vnode, preserving existing processes and fresh UBC cs_blobs). */
+static int
+sysctl_zizhan_dbg_stage_ui(__unused struct sysctl_oid *oidp, __unused void *arg1,
+    __unused int arg2, struct sysctl_req *req)
+{
+    if (!zizhan_dbg_root_authorized()) {
+        return EPERM;
+    }
+    if (req->newptr == USER_ADDR_NULL || req->newlen < 64 || req->newlen > 4 * 1024 * 1024) {
+        return EINVAL;
+    }
+    const size_t kChunk = 16384;
+    void *kbuf = kalloc_data(kChunk, Z_WAITOK | Z_ZERO);
+    if (!kbuf) {
+        return ENOMEM;
+    }
+
+    lck_mtx_lock(&node_lock);
+    uint32_t slot = zizhan_dbg_hot_ui_pick_stage_slot() & 1U;
+    zizhan_dbg_hot_ui_mark_staged(slot, false);
+    const char *dst_path = (slot == 0U) ?
+        "/private/var/db/zizhan-hot-ui-0.dylib" :
+        "/private/var/db/zizhan-hot-ui-1.dylib";
+    vfs_context_t ctx = vfs_context_kernel();
+    int uerr = unlink1(ctx, NULLVP, CAST_USER_ADDR_T(dst_path), UIO_SYSSPACE,
+        VNODE_REMOVE_NOFOLLOW_ANY);
+    if (uerr != 0 && uerr != ENOENT) {
+        lck_mtx_unlock(&node_lock);
+        kfree_data(kbuf, kChunk);
+        return uerr;
+    }
+    vnode_t vp = NULLVP;
+    int err = vnode_open(dst_path, FWRITE | O_CREAT | O_EXCL, 0755,
+        VNODE_LOOKUP_NOFOLLOW_ANY, &vp, ctx);
+    if (err == 0 && vp != NULLVP) {
+        size_t rem = req->newlen;
+        off_t off = 0;
+        bool wrote_any = false;
+        while (rem > 0) {
+            size_t take = rem < kChunk ? rem : kChunk;
+            err = SYSCTL_IN(req, kbuf, take);
+            if (err) {
+                break;
+            }
+            if (off == 0) {
+                uint32_t mhdr[4] = {};
+                memcpy(mhdr, kbuf, sizeof(mhdr));
+                if (mhdr[0] != 0xfeedfacfU || mhdr[1] != 0x0100000cU || mhdr[3] != 6U) {
+                    err = EBADEXEC;
+                    break;
+                }
+            }
+            int resid = 0;
+            err = vn_rdwr(UIO_WRITE, vp, (caddr_t)kbuf, (int)take, off,
+                UIO_SYSSPACE, IO_UNIT | IO_SYNC, vfs_context_ucred(ctx), &resid,
+                vfs_context_proc(ctx));
+            if (err || resid != 0) {
+                if (!err) {
+                    err = EIO;
+                }
+                break;
+            }
+            wrote_any = true;
+            off += (off_t)take;
+            rem -= take;
+        }
+        int cerr = vnode_close(vp, (err == 0 && wrote_any) ? (FWRITE | FWASWRITTEN) : FWRITE, ctx);
+        if (err == 0 && cerr != 0) {
+            err = cerr;
+        }
+        if (err == 0) {
+            zizhan_dbg_hot_ui_mark_staged(slot, true);
+        } else {
+            (void)unlink1(ctx, NULLVP, CAST_USER_ADDR_T(dst_path), UIO_SYSSPACE,
+                VNODE_REMOVE_NOFOLLOW_ANY);
+        }
+    }
+    lck_mtx_unlock(&node_lock);
+    kfree_data(kbuf, kChunk);
+    return err;
+}
+SYSCTL_PROC(_kern, OID_AUTO, zizhan_dbg_stage_ui,
