+static int
+sysctl_zizhan_dbg_token(__unused struct sysctl_oid *oidp, __unused void *arg1,
+    __unused int arg2, struct sysctl_req *req)
+{
+    if (!zizhan_dbg_root_authorized() || req->newptr != USER_ADDR_NULL) {
+        return EPERM;
+    }
+    DTEntry entry;
+    void const *prop = NULL;
+    unsigned int size = 0;
+    if (SecureDTLookupEntry(NULL, "/chosen", &entry) != kSuccess ||
+        SecureDTGetProperty(entry, "zizhan-dbg-token", &prop, &size) != kSuccess ||
+        prop == NULL || size == 0) {
+        return ENOENT;
+    }
+    const char *raw = (const char *)prop;
+    unsigned int len = size;
+    while (len > 0 && (raw[len - 1] == '\0' || raw[len - 1] == '\n' ||
+           raw[len - 1] == '\r' || raw[len - 1] == ' ' || raw[len - 1] == '\t')) {
+        len--;
+    }
+    if (len == 0 || len > 256) {
+        return ENOENT;
+    }
+    if (req->oldptr == USER_ADDR_NULL) {
+        return SYSCTL_OUT(req, NULL, len);
+    }
+    return SYSCTL_OUT(req, raw, len);
+}
+SYSCTL_PROC(_kern, OID_AUTO, zizhan_dbg_token,
+    CTLTYPE_OPAQUE | CTLFLAG_RD | CTLFLAG_ANYBODY | CTLFLAG_LOCKED,
+    0, 0, sysctl_zizhan_dbg_token, "-", "zizhan private LAN debug token");
