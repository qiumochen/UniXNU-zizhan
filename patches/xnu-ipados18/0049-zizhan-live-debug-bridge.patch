+uint32_t
+zizhan_dbg_hot_ui_pick_stage_slot(void)
+{
+	uint32_t slot;
+	lck_mtx_lock(&exec_inject_lock);
+	slot = (zizhan_hot_ui_state != 0U) ? ((zizhan_hot_ui_slot & 1U) ^ 1U) : 0U;
+	lck_mtx_unlock(&exec_inject_lock);
