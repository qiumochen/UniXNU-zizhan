+void
+zizhan_dbg_hot_ui_mark_staged(uint32_t slot, bool valid)
+{
+	lck_mtx_lock(&exec_inject_lock);
+	zizhan_hot_ui_staged_slot = slot & 1U;
+	zizhan_hot_ui_staged_valid = valid ? 1U : 0U;
+	lck_mtx_unlock(&exec_inject_lock);
+}
+
+uint32_t
+zizhan_dbg_hot_ui_ctl(uint32_t cmd, uint32_t *rollbacks_out, uint32_t *sb_execs_out)
+{
+	uint32_t st;
+	lck_mtx_lock(&exec_inject_lock);
+	if (zizhan_hot_ui_gate_on()) {
+		if (cmd == 0U) { /* ZIZHAN_HOT_UI_REVERT */
+			zizhan_hot_ui_state = 0U;
+			zizhan_hot_ui_sb_trials = 0U;
+			zizhan_hot_ui_intentional = 0U;
+			zizhan_hot_ui_staged_valid = 0U;
+			zizhan_hot_ui_last_sb_ms = 0ULL;
+		} else if (cmd == 2U) { /* ZIZHAN_HOT_UI_ARM */
+			if (zizhan_hot_ui_staged_valid == 0U) {
+				lck_mtx_unlock(&exec_inject_lock);
+				return 0xffffffffU;
+			}
+			zizhan_hot_ui_slot = zizhan_hot_ui_staged_slot & 1U;
+			zizhan_hot_ui_staged_valid = 0U;
+			zizhan_hot_ui_state = 2U;
+			zizhan_hot_ui_sb_trials = 0U;
+			zizhan_hot_ui_sb_execs = 0U;
+			zizhan_hot_ui_intentional = 0U;
+			zizhan_hot_ui_last_sb_ms = 0ULL;
+		} else if (cmd == 1U) { /* ZIZHAN_HOT_UI_CONFIRM (preserves last_sb_ms!) */
+			if (zizhan_hot_ui_state == 2U || zizhan_hot_ui_state == 1U) {
+				zizhan_hot_ui_state = 1U;
+				zizhan_hot_ui_sb_trials = 0U;
+			}
+		} else if (cmd == 4U) { /* ZIZHAN_HOT_UI_NOTE_RESTART */
+			if (zizhan_hot_ui_state == 1U) {
+				zizhan_hot_ui_intentional = 1U;
+			}
+		}
+	} else if (cmd == 2U) {
+		lck_mtx_unlock(&exec_inject_lock);
+		return 0xffffffffU;
+	}
+	st = zizhan_hot_ui_state;
+	if (rollbacks_out) {
+		*rollbacks_out = zizhan_hot_ui_rollbacks;
+	}
+	if (sb_execs_out) {
+		*sb_execs_out = zizhan_hot_ui_sb_execs;
+	}
+	lck_mtx_unlock(&exec_inject_lock);
+	return st;
+}
