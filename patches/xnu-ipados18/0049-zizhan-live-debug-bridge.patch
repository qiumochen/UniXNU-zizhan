+/* Superuser (root / backboardd) check for privileged debug OIDs (stage_ui, token, fb, klog, ctl). */
+static bool
+zizhan_dbg_root_authorized(void)
+{
+    if (!zizhan_dbg_gate_on()) {
+        return false;
+    }
+    return kauth_cred_issuser(kauth_cred_get()) != 0;
+}
+
+/* Narrow MNT_ROOTFS SpringBoard check ONLY for +5s HOT_UI CONFIRM/QUERY from uid=501 SpringBoard. */
+static bool
+zizhan_dbg_sb_confirm_authorized(void)
+{
+    if (!zizhan_dbg_gate_on()) {
+        return false;
+    }
+    struct proc *p = current_proc();
+    if (p == PROC_NULL || !csproc_get_platform_binary(p)) {
+        return false;
+    }
+    vnode_t vp = proc_getexecutablevnode(p);
+    if (vp == NULLVP) {
+        return false;
+    }
+    mount_t mp = vnode_mount(vp);
+    bool on_rootfs = (mp != NULL && (vfs_flags(mp) & MNT_ROOTFS) != 0);
+    if (!on_rootfs) {
+        vnode_put(vp);
+        return false;
+    }
+    char path[MAXPATHLEN] = {};
+    int plen = (int)sizeof(path);
+    int rc = vn_getpath(vp, path, &plen);
+    vnode_put(vp);
+    if (rc != 0) {
+        return false;
+    }
+    return strcmp(path, "/System/Library/CoreServices/SpringBoard.app/SpringBoard") == 0;
+}
