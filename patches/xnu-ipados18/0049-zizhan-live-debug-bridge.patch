+static int
+zizhan_dbg_find_sb_cb(proc_t p, void *arg)
+{
+    char name[32] = {};
+    proc_name(proc_pid(p), name, sizeof(name));
+    if (strcmp(name, "SpringBoard") == 0) {
+        *(int *)arg = proc_pid(p);
+        return PROC_RETURNED_DONE;
+    }
+    return PROC_RETURNED;
+}
+
+int
+zizhan_dbg_signal_springboard(int sig)
+{
+    if (sig != SIGTERM && sig != SIGKILL) {
+        return -1;
+    }
+    int pid = -1;
+    proc_iterate(PROC_ALLPROCLIST, zizhan_dbg_find_sb_cb, &pid, NULL, NULL);
+    if (pid <= 0) {
+        return -1;
+    }
+    proc_t p = proc_find(pid);
+    if (p == PROC_NULL) {
+        return -1;
+    }
+    psignal(p, sig);
+    proc_rele(p);
+    return pid;
+}
