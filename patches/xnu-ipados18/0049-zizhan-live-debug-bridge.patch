+static bool
+zizhan_dbg_gate_on(void)
+{
+    int gate = __atomic_load_n(&dbg_gate_cached, __ATOMIC_ACQUIRE);
+    if (gate < 0) {
+        uint32_t en = 0;
+        gate = (PE_parse_boot_argn("zizhan_debugd", &en, sizeof(en)) && en != 0) ? 1 : 0;
+        __atomic_store_n(&dbg_gate_cached, gate, __ATOMIC_RELEASE);
+    }
+    return gate != 0;
+}
